//@version=5

// Markov Hedge Fund Method
// Signal = P(next=Bull|today) - P(next=Bear|today)
// Green flag = entry   Red flag = exit to neutral

strategy("Markov Hedge Fund Method", overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.05)

// ============================================================
// HELPER FUNCTIONS
// ============================================================

safe_div(n, d) => d > 0.0 ? n / d : 0.0
to_pct(v)      => str.tostring(math.round(v * 100.0, 1)) + "%"

// ============================================================
// INPUTS
// ============================================================

lookback = input.int(20, "Lookback Bars", minval=5, group="State Classification", tooltip="Bars used to compute the cumulative return that labels each state.")
bull_raw = input.float(5.0, "Bull Threshold (%)", minval=0.1, step=0.5, group="State Classification", tooltip="Cumulative return >= this value = Bull state.")
bear_raw = input.float(5.0, "Bear Threshold (%)", minval=0.1, step=0.5, group="State Classification", tooltip="Cumulative return <= negative this value = Bear state.")
show_tbl = input.bool(true, "Show Transition Matrix", group="Display")
show_bg  = input.bool(true, "Colour Background by State", group="Display")

bull_pct = bull_raw / 100.0
bear_pct = bear_raw / 100.0

// ============================================================
// STATE CLASSIFICATION   0=Bull  1=Sideways  2=Bear
// ============================================================

cum_ret = (close - close[lookback]) / close[lookback]
state   = cum_ret >= bull_pct ? 0 : cum_ret <= -bear_pct ? 2 : 1
s_prev  = nz(state[1], 1)

// ============================================================
// TRANSITION COUNT ACCUMULATION
// Flat 3x3 array, index = (from_state * 3) + to_state
//   0 Bull>Bull   1 Bull>Side   2 Bull>Bear
//   3 Side>Bull   4 Side>Side   5 Side>Bear
//   6 Bear>Bull   7 Bear>Side   8 Bear>Bear
// ============================================================

var float[] tc = array.new_float(9, 0.0)

if barstate.isconfirmed
    int k = s_prev * 3 + state
    array.set(tc, k, array.get(tc, k) + 1.0)

r0 = array.get(tc, 0) + array.get(tc, 1) + array.get(tc, 2)
r1 = array.get(tc, 3) + array.get(tc, 4) + array.get(tc, 5)
r2 = array.get(tc, 6) + array.get(tc, 7) + array.get(tc, 8)

p_bb = safe_div(array.get(tc, 0), r0)
p_bs = safe_div(array.get(tc, 1), r0)
p_bB = safe_div(array.get(tc, 2), r0)
p_sb = safe_div(array.get(tc, 3), r1)
p_ss = safe_div(array.get(tc, 4), r1)
p_sB = safe_div(array.get(tc, 5), r1)
p_Bb = safe_div(array.get(tc, 6), r2)
p_Bs = safe_div(array.get(tc, 7), r2)
p_BB = safe_div(array.get(tc, 8), r2)

// ============================================================
// SIGNAL = P(next=Bull|today) - P(next=Bear|today)
// ============================================================

signal = state == 0 ? p_bb - p_bB : state == 1 ? p_sb - p_sB : p_Bb - p_BB

// ============================================================
// STRATEGY EXECUTION
// ============================================================

qty_pct = math.abs(signal) * 100.0

if signal > 0.0
    strategy.entry("Long", strategy.long, qty_percent=qty_pct)
if signal < 0.0
    strategy.entry("Short", strategy.short, qty_percent=qty_pct)
if signal == 0.0
    strategy.close_all()

// ============================================================
// ENTRY / EXIT FLAGS
// ============================================================

prev_sig    = nz(signal[1])
long_entry  = signal > 0.0 and prev_sig <= 0.0
short_entry = signal < 0.0 and prev_sig >= 0.0
any_entry   = long_entry or short_entry
any_exit    = signal == 0.0 and prev_sig != 0.0

if any_entry
    label.new(bar_index, signal, "", color=color.new(color.green, 0), textcolor=color.white, style=label.style_flag, size=size.small)

if any_exit
    label.new(bar_index, prev_sig, "", color=color.new(color.red, 0), textcolor=color.white, style=label.style_flag, size=size.small)

// ============================================================
// VISUALS
// ============================================================

sig_col  = signal > 0.0 ? color.green : signal < 0.0 ? color.red : color.gray
state_bg = state == 0 ? color.new(color.green, 87) : state == 2 ? color.new(color.red, 87) : color.new(color.gray, 93)

plot(signal, "Signal", color=sig_col, linewidth=2, style=plot.style_histogram)
plot(signal, "Signal Line", color=sig_col, linewidth=1)
hline(0, "Zero", color=color.new(color.white, 60), linestyle=hline.style_dashed)
bgcolor(show_bg ? state_bg : na, title="State Background")

// ============================================================
// TRANSITION MATRIX TABLE (top-right, last bar only)
// ============================================================

var table mat = table.new(position.top_right, 5, 5, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.new(color.gray, 40))

if show_tbl and barstate.islast
    // Header row
    table.cell(mat, 0, 0, "From/To",  text_color=color.white,  text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 1, 0, "Bull",     text_color=color.green,  text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 2, 0, "Side",     text_color=color.silver, text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 3, 0, "Bear",     text_color=color.red,    text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 4, 0, "Signal",   text_color=color.yellow, text_size=size.small, text_halign=text.align_center)
    // Row labels
    table.cell(mat, 0, 1, "Bull",     text_color=color.green,  text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 0, 2, "Side",     text_color=color.silver, text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 0, 3, "Bear",     text_color=color.red,    text_size=size.small, text_halign=text.align_center)
    // Bull row
    table.cell(mat, 1, 1, to_pct(p_bb),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 2, 1, to_pct(p_bs),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 3, 1, to_pct(p_bB),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 4, 1, to_pct(p_bb - p_bB), text_color=p_bb - p_bB >= 0.0 ? color.green : color.red, text_size=size.small, text_halign=text.align_center)
    // Sideways row
    table.cell(mat, 1, 2, to_pct(p_sb),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 2, 2, to_pct(p_ss),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 3, 2, to_pct(p_sB),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 4, 2, to_pct(p_sb - p_sB), text_color=p_sb - p_sB >= 0.0 ? color.green : color.red, text_size=size.small, text_halign=text.align_center)
    // Bear row
    table.cell(mat, 1, 3, to_pct(p_Bb),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 2, 3, to_pct(p_Bs),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 3, 3, to_pct(p_BB),        text_color=color.white,                                text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 4, 3, to_pct(p_Bb - p_BB), text_color=p_Bb - p_BB >= 0.0 ? color.green : color.red, text_size=size.small, text_halign=text.align_center)
    // Current state and live signal
    now_lbl = state == 0 ? "BULL" : state == 2 ? "BEAR" : "SIDE"
    now_col = state == 0 ? color.green : state == 2 ? color.red : color.silver
    sig_str = signal > 0.0 ? "LONG  " + to_pct(signal) : signal < 0.0 ? "SHORT " + to_pct(math.abs(signal)) : "NEUTRAL"
    sig_c   = signal >= 0.0 ? color.green : color.red
    table.cell(mat, 0, 4, "Now: " + now_lbl, text_color=now_col, text_size=size.small, text_halign=text.align_center)
    table.cell(mat, 4, 4, sig_str,            text_color=sig_c,  text_size=size.small, text_halign=text.align_center)
