# ===========================================================================
# XAU/USD OANDA Telegram Trading Bot — environment configuration
# Copy this file to ".env" and fill in your own values. NEVER commit .env.
# ===========================================================================

# --- Telegram --------------------------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Optional: your numeric chat id (from @userinfobot) for push notifications.
TELEGRAM_CHAT_ID=

# --- OANDA -----------------------------------------------------------------
# Generate a personal access token in your OANDA account (Manage API Access).
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# practice (default, recommended) or live.
OANDA_ENV=practice
OANDA_INSTRUMENT=XAU_USD

# --- OpenAI (optional) -----------------------------------------------------
# If set, the analysis commentary is rewritten by OpenAI. If empty, the bot
# falls back to the deterministic rule-based report.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Analysis defaults -----------------------------------------------------
DEFAULT_TIMEFRAME=M15
DEFAULT_CANDLE_COUNT=150
DEFAULT_RISK_PERCENT=1.0
DEFAULT_ACCOUNT_BALANCE=10000

# --- Safety controls -------------------------------------------------------
# Live trading and order execution stay OFF unless ALL of these are flipped.
ALLOW_LIVE_TRADING=false
ADVISORY_ONLY=true

# --- Internal service URLs (leave as-is for docker-compose) ----------------
OANDA_SERVICE_URL=http://oanda-service:8001
ANALYSIS_SERVICE_URL=http://analysis-service:8000
