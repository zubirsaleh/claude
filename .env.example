# Telegram — get a bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID by messaging @userinfobot
TELEGRAM_ALLOWED_USERS=123456789

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TradingView credentials (optional — needed for premium data)
# Without these, the bot uses TradingView's free public data
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# How many conversation turns to keep in memory per user
MAX_HISTORY=20
