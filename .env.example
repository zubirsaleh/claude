# Telegram — get a bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID by messaging @userinfobot
TELEGRAM_ALLOWED_USERS=123456789

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TradingView credentials (optional — needed for premium data)
# Without these, the bot uses TradingView's free public data
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# How many conversation turns to keep in memory per user
MAX_HISTORY=20

# ---------------------------------------------------------------------------
# TSCH (V2). Prefer secret FILES over values; never commit real secrets.
# Docker Compose reads secrets from ./secrets (run infra/scripts/dev-secrets.sh).
# ---------------------------------------------------------------------------
TSCH_DATABASE_URL=postgresql+psycopg://tsch@localhost:5432/tsch
TSCH_DATABASE_PASSWORD_FILE=./secrets/db_password
TSCH_OPERATOR_TOKEN_FILE=./secrets/operator_token
TSCH_DEFAULT_MODE=SIM
TSCH_APPROVAL_TTL_SECONDS=120
TSCH_DISPLAY_TIMEZONE=Asia/Kuala_Lumpur
# Risk policy (2% is a hard ceiling in code; defaults are deliberately lower)
TSCH_RISK_MAX_RISK_PCT=0.5
TSCH_RISK_MAX_DAILY_LOSS_PCT=2
TSCH_RISK_MAX_DRAWDOWN_PCT=5
TSCH_RISK_MAX_OPEN_POSITIONS=3
# Public hostname for Caddy (automatic HTTPS); ":80" for local smoke tests
TSCH_SITE_ADDRESS=localhost
# Host-side mt5-agent only (never inside Docker). Token file is created from the MT5 GUI.
TSCH_MT5_MCP_URL=http://127.0.0.1:22346/mcp
TSCH_MT5_MCP_TOKEN_FILE=/etc/tsch/mt5_mcp_token
